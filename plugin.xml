<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="https://www.dita-ot.org/rng/plugin.rnc" type="application/relax-ng-compact-syntax"?>
<plugin id="org.dita-bootstrap.ast">
  <require plugin="org.dita.base"/>

  <!-- extension points -->
  <extension-point
    id="dita.xsl.ast-bootstrap"
    name="Bootstrap AST XSLT import"
  />

  <!-- Offers two additional extension points for dependent plug-ins -->
  <extension-point
    id="ast-bootstrap.process.pre"
    name="Custom AST Bootstrap pre-processing"
  />
  <extension-point
    id="ast-bootstrap.process.post"
    name="Custom AST Bootstrap post-processing"
  />

  <transtype
    name="ast-bootstrap"
    desc="Serializes the DITA topic/map tree as a JSON react-bootstrap component tree"
  >
    <param
      name="args.ast.toc"
      desc="Specifies the base name of the merged TOC/nav JSON file."
      type="string"
    />
    <param
      name="args.breadcrumbs"
      desc="Specifies whether to include a meta.breadcrumbs title/href trail in each topic's AST."
      type="enum"
    >
      <val>yes</val>
      <val default="true">no</val>
    </param>
    <!-- same param names/values as dita-bootstrap's html5-bootstrap transtype; not all modes are
         rendered by react-harness yet, but the value threads through to toc.json either way -->
    <param
      name="nav-toc"
      type="enum"
      desc="Value passed through to toc.json's navToc field for the frontend to interpret."
    >
      <val desc="No TOC">none</val>
      <val desc="Partial TOC that shows the current topic">partial</val>
      <val desc="Full TOC">full</val>
      <val
        desc="Bootstrap styled partial TOC with descendents in a list-group"
      >list-group-partial</val>
      <val
        desc="Bootstrap styled full TOC using a list-group"
      >list-group-full</val>
      <val
        desc="Bootstrap styled partial TOC with descendents in nav-pills"
      >nav-pill-partial</val>
      <val
        desc="Bootstrap styled full ToC using indented nav-pills"
      >nav-pill-full</val>
      <val
        default="true"
        desc="Bootstrap styled collapsible menu"
      >collapsible</val>
    </param>
    <param
      name="scrollspy-toc"
      type="enum"
      desc="Value passed through to toc.json's scrollspyToc field for the frontend to interpret."
    >
      <val default="true">none</val>
      <val>list</val>
      <val desc="Scrollspy menu using a list-group">list-group</val>
      <val desc="Scrollspy menu using indented nav-pills">nav-pill</val>
    </param>
  </transtype>

  <feature extension="ant.import" file="build_dita2ast-bootstrap.xml"/>

  <!-- Add template files to enable overrides to use extension points -->
  <template file="build_dita2ast-bootstrap_template.xml"/>
  <template file="xsl/dita2ast-bootstrapImpl_template.xsl"/>
</plugin>
