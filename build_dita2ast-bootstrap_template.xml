<project
  xmlns:dita="http://dita-ot.sourceforge.net"
  xmlns:if="ant:if"
  xmlns:unless="ant:unless"
  name="dita2ast-bootstrap"
>

  <target
    name="dita2ast-bootstrap"
    dita:depends="{ast-bootstrap.process.pre},ast-bootstrap.init,
             build-init,
             preprocess2,
             ast-bootstrap.topic,
             ast-bootstrap.map,{ast-bootstrap.process.post}"
    dita:extension="depends org.dita.dost.platform.InsertDependsAction"
  />

  <target name="ast-bootstrap.init">
    <property
      name="args.xsl"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/xsl/dita2ast-bootstrap.xsl"
    />
    <property
      name="args.ast.toc.xsl"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/xsl/map2ast-bootstrap.xsl"
    />
    <property
      name="args.hdr"
      location="${dita.plugin.org.dita-bootstrap.ast.dir}/includes/hdr.navbar.default.xml"
    />
    <dita-ot-fail id="DOTA069F" if:set="args.hdr">
      <condition>
        <not>
          <available file="${args.hdr}" type="file"/>
        </not>
      </condition>
      <param name="1" value="${args.hdr}"/>
    </dita-ot-fail>
    <dita-ot-fail id="DOTA069F" if:set="args.ftr">
      <condition>
        <not>
          <available file="${args.ftr}" type="file"/>
        </not>
      </condition>
      <param name="1" value="${args.ftr}"/>
    </dita-ot-fail>
    <pathconvert property="args.hdr.file" if:set="args.hdr">
      <first>
        <filelist dir="${dita.dir}" files="${args.hdr}"/>
      </first>
    </pathconvert>
    <pathconvert property="args.ftr.file" if:set="args.ftr">
      <first>
        <filelist dir="${dita.dir}" files="${args.ftr}"/>
      </first>
    </pathconvert>
    <makeurl
      file="${args.hdr.file}"
      property="args.hdr.url"
      validate="no"
      if:set="args.hdr.file"
    />
    <makeurl
      file="${args.ftr.file}"
      property="args.ftr.url"
      validate="no"
      if:set="args.ftr.file"
    />
    <condition property="out.ext" value=".json">
      <not>
        <isset property="args.outext"/>
      </not>
    </condition>
    <property name="args.ast.toc" value="toc"/>
  </target>

  <target name="ast-bootstrap.topic.init">
    <makeurl
      file="${dita.input.valfile}"
      property="dita.input.valfile.url"
      validate="no"
      if:set="dita.input.valfile"
    />
    <!-- needed by Customization/xsl/breadcrumb.xsl to walk ancestor topicrefs; same
         mechanism as org.dita.html5's build_dita2html5.xml html5.map.url -->
    <pathconvert property="ast-bootstrap.map.url" unless:set="noMap">
      <first>
        <ditafileset format="ditamap" input="true"/>
      </first>
    </pathconvert>
  </target>

  <target name="ast-bootstrap.topic" depends="ast-bootstrap.topic.init">
    <ast-bootstrap.topics/>
  </target>

  <target name="ast-bootstrap.map">
    <ast-bootstrap.map/>
  </target>

  <macrodef name="ast-bootstrap.topics">
    <sequential>
      <pipeline
        message="Convert DITA topic to Bootstrap AST JSON"
        taskname="xslt"
      >
      <xslt
          destdir="${dita.output.dir}"
          extension="${out.ext}"
          style="${args.xsl}"
          filenameparameter="FILENAME"
          filedirparameter="FILEDIR"
          parallel="${parallel}"
        >
        <ditafileset format="dita" processingRole="normal"/>
        <param
            name="FILTERFILE"
            expression="${dita.input.valfile.url}"
            if:set="dita.input.valfile"
          />
        <param name="OUTEXT" expression="${out.ext}" if:set="out.ext"/>
        <param
            name="BREADCRUMBS"
            expression="${args.breadcrumbs}"
            if:set="args.breadcrumbs"
          />
        <param
            name="DEFAULTLANG"
            expression="${default.language}"
            if:set="default.language"
          />
        <param
            name="input.map.url"
            expression="${ast-bootstrap.map.url}"
            if:set="ast-bootstrap.map.url"
          />
        <param
            name="scrollspy-toc"
            expression="${scrollspy-toc}"
            if:set="scrollspy-toc"
          />
        <mapper classname="org.dita.dost.ant.types.JobMapper" to="${out.ext}"/>
        <xmlcatalog refid="dita.catalog"/>
      </xslt>
      </pipeline>
    </sequential>
  </macrodef>

  <macrodef name="ast-bootstrap.map">
    <sequential>
      <pipeline
        message="Convert DITA map to Bootstrap AST JSON TOC"
        taskname="xslt"
      >
      <xslt destdir="${dita.output.dir}" style="${args.ast.toc.xsl}">
        <ditafileset input="true" format="ditamap"/>
        <param
            name="FILTERFILE"
            expression="${dita.input.valfile.url}"
            if:set="dita.input.valfile"
          />
        <param name="OUTEXT" expression="${out.ext}" if:set="out.ext"/>
        <param
            name="DEFAULTLANG"
            expression="${default.language}"
            if:set="default.language"
          />
        <param name="HDR" expression="${args.hdr.url}" if:set="args.hdr.url"/>
        <param name="FTR" expression="${args.ftr.url}" if:set="args.ftr.url"/>
        <param name="nav-toc" expression="${nav-toc}" if:set="nav-toc"/>
        <param
            name="scrollspy-toc"
            expression="${scrollspy-toc}"
            if:set="scrollspy-toc"
          />
        <param
            name="menubar-toc.include"
            expression="${menubar-toc.include}"
            if:set="menubar-toc.include"
          />
        <mapper type="merge" to="${args.ast.toc}${out.ext}"/>
        <xmlcatalog refid="dita.catalog"/>
      </xslt>
      </pipeline>
    </sequential>
  </macrodef>

  <target
    name="dita2ast-chrome"
    depends="build-init,ast-chrome.init,ast-chrome.placeholder,ast-chrome.process"
  />
  <target name="ast-chrome" depends="dita2ast-chrome"/>

  <target name="ast-chrome.init">
    <property
      name="dita.plugin.org.dita-bootstrap.ast.dir"
      location="${dita.dir}/plugins/dita-bootstrap.ast"
    />
    <property
      name="args.ast.chrome.xsl"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/xsl/chrome2ast-bootstrap.xsl"
    />
    <property
      name="args.ast.placeholder.xsl"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/xsl/placeholder-text.xsl"
    />
    <property
      name="args.ast.placeholder.dummy"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/resource/dummy.xml"
    />

    <!-- Default template locations -->
    <property
      name="args.docs-page.hdr"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/includes/chrome.navbar.docs-page.xml"
    />
    <property
      name="args.docs-page.card"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/includes/chrome.content.docs-page.xml"
    />
    <property
      name="args.chat-bot.hdr"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/includes/chrome.navbar.chat-bot.xml"
    />
    <property
      name="args.chat-bot.card"
      value="${dita.plugin.org.dita-bootstrap.ast.dir}/includes/chrome.content.chat-bot.xml"
    />

    <!-- Validate template file locations -->
    <dita-ot-fail id="DOTA069F" if:set="args.docs-page.hdr">
      <condition>
        <not>
          <available file="${args.docs-page.hdr}" type="file"/>
        </not>
      </condition>
      <param name="1" value="${args.docs-page.hdr}"/>
    </dita-ot-fail>
    <dita-ot-fail id="DOTA069F" if:set="args.docs-page.card">
      <condition>
        <not>
          <available file="${args.docs-page.card}" type="file"/>
        </not>
      </condition>
      <param name="1" value="${args.docs-page.card}"/>
    </dita-ot-fail>
    <dita-ot-fail id="DOTA069F" if:set="args.chat-bot.hdr">
      <condition>
        <not>
          <available file="${args.chat-bot.hdr}" type="file"/>
        </not>
      </condition>
      <param name="1" value="${args.chat-bot.hdr}"/>
    </dita-ot-fail>
    <dita-ot-fail id="DOTA069F" if:set="args.chat-bot.card">
      <condition>
        <not>
          <available file="${args.chat-bot.card}" type="file"/>
        </not>
      </condition>
      <param name="1" value="${args.chat-bot.card}"/>
    </dita-ot-fail>
    <dita-ot-fail id="DOTA069F" if:set="args.chat-bot.form">
      <condition>
        <not>
          <available file="${args.chat-bot.form}" type="file"/>
        </not>
      </condition>
      <param name="1" value="${args.chat-bot.form}"/>
    </dita-ot-fail>
    <dita-ot-fail id="DOTA069F" if:set="args.footer">
      <condition>
        <not>
          <available file="${args.footer}" type="file"/>
        </not>
      </condition>
      <param name="1" value="${args.footer}"/>
    </dita-ot-fail>

    <!-- Convert paths to URLs for XSLT doc() loading -->
    <makeurl
      file="${args.docs-page.hdr}"
      property="args.docs-page.hdr.url"
      validate="no"
      if:set="args.docs-page.hdr"
    />
    <makeurl
      file="${args.docs-page.card}"
      property="args.docs-page.card.url"
      validate="no"
      if:set="args.docs-page.card"
    />
    <makeurl
      file="${args.chat-bot.hdr}"
      property="args.chat-bot.hdr.url"
      validate="no"
      if:set="args.chat-bot.hdr"
    />
    <makeurl
      file="${args.chat-bot.card}"
      property="args.chat-bot.card.url"
      validate="no"
      if:set="args.chat-bot.card"
    />
    <makeurl
      file="${args.chat-bot.form}"
      property="args.chat-bot.form.url"
      validate="no"
      if:set="args.chat-bot.form"
    />
    <makeurl
      file="${args.footer}"
      property="args.footer.url"
      validate="no"
      if:set="args.footer"
    />
  </target>

  <target name="ast-chrome.process" depends="ast-chrome.init">
    <ast-chrome.generate/>
  </target>

  <macrodef name="ast-chrome.generate">
    <sequential>
      <mkdir dir="${dita.output.dir}"/>
      <xslt
        in="${args.docs-page.hdr}"
        out="${dita.output.dir}/chrome.json"
        style="${args.ast.chrome.xsl}"
      >
        <param
          name="DOCS_PAGE_HDR"
          expression="${args.docs-page.hdr.url}"
          if:set="args.docs-page.hdr.url"
        />
        <param
          name="DOCS_PAGE_CARD"
          expression="${args.docs-page.card.url}"
          if:set="args.docs-page.card.url"
        />
        <param
          name="CHAT_BOT_HDR"
          expression="${args.chat-bot.hdr.url}"
          if:set="args.chat-bot.hdr.url"
        />
        <param
          name="CHAT_BOT_CARD"
          expression="${args.chat-bot.card.url}"
          if:set="args.chat-bot.card.url"
        />
        <param
          name="CHAT_BOT_FORM"
          expression="${args.chat-bot.form.url}"
          if:set="args.chat-bot.form.url"
        />
        <param
          name="FOOTER"
          expression="${args.footer.url}"
          if:set="args.footer.url"
        />
        <param name="NO_RESULTS" expression="${no.results}"/>
        <param name="TABLE_OF_CONTENTS" expression="${table.of.contents}"/>
        <param name="MENUBAR_NAVIGATION" expression="${menubar.navigation}"/>
        <param name="EXPAND" expression="${expand}"/>
        <param name="COLLAPSE" expression="${collapse}"/>
        <xmlcatalog refid="dita.catalog"/>
      </xslt>
    </sequential>
  </macrodef>

  <target
    name="ast-chrome.placeholder"
    depends="ast-chrome.init"
    description="Resolve localized chrome.json UI text"
  >
    <macrodef name="get-placeholder">
    <attribute name="property"/>
    <sequential>
      <tempfile
          property="ast-chrome.placeholder.file.@{property}"
          deleteonexit="true"
          destdir="${dita.temp.dir}"
          createfile="true"
        />
      <pipeline taskname="placeholder">
        <xslt
            classpathref="dost.class.path"
            style="${args.ast.placeholder.xsl}"
            in="${args.ast.placeholder.dummy}"
            out="${ast-chrome.placeholder.file.@{property}}"
          >
          <param name="text" expression="@{property}"/>
          <param name="defaultLanguage" expression="${default.language}"/>
        </xslt>
      </pipeline>
      <loadfile
          failonerror="true"
          property="@{property}"
          srcfile="${ast-chrome.placeholder.file.@{property}}"
        />
    </sequential>
  </macrodef>

    <get-placeholder property="no.results"/>
    <get-placeholder property="table.of.contents"/>
    <get-placeholder property="menubar.navigation"/>
    <get-placeholder property="expand"/>
    <get-placeholder property="collapse"/>
  </target>

</project>
